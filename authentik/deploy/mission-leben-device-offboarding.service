[Unit]
Description=Reconcile inactive Authentik users and blocked Mission Leben mobile devices
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=ML_OFFBOARD_RECONCILE_APPLY=1
ExecStart=/opt/mission-leben-device-offboarding/reconcile-inactive-devices.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock /var/lib/mission-leben-device-offboarding
RestrictAddressFamilies=AF_UNIX
