BRIDGE_LISTEN_HOST=0.0.0.0
BRIDGE_LISTEN_PORT=8080
BRIDGE_DATABASE_PATH=/data/bridge.sqlite3
BRIDGE_AUTHENTIK_USERINFO_URL=https://id.mission-leben.de/application/o/userinfo/
BRIDGE_INTERNAL_HMAC_SECRET=replace-with-at-least-32-random-characters
BRIDGE_ADMIN_API_KEY=replace-with-a-separate-32-character-secret
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
BRIDGE_DATA_KEY=replace-with-base64url-encoded-32-byte-key
BRIDGE_FIREBASE_PROJECT_ID=mission-leben-portal
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
BRIDGE_TALK_TARGETS_JSON=[]
BRIDGE_NEXTCLOUD_BACKEND_URL=https://cloud.example.invalid
BRIDGE_NEXTCLOUD_TALK_SECRET_FILE=/run/secrets/nextcloud-talk-bot-secret
# room token -> Authentik subjects that should receive this room's messages
BRIDGE_TALK_RECIPIENTS_JSON={}
# Nextcloud user id -> Authentik subject; used to suppress a notification to the sender
BRIDGE_NEXTCLOUD_USER_SUBJECTS_JSON={}

BRIDGE_BASE_URL=http://bridge:8080
ZIMBRA_ADMIN_SOAP_URL=https://mailbox01.example.invalid:7071/service/admin/soap
ZIMBRA_MAIL_SOAP_URL=https://mailbox01.example.invalid/service/soap
ZIMBRA_ADMIN_USER=portal-notify@example.invalid
ZIMBRA_ADMIN_PASSWORD_FILE=/run/secrets/zimbra-admin-password
ZIMBRA_ACCOUNT_MAP_FILE=/run/secrets/zimbra-account-map.json
ZIMBRA_TIMEZONE=Europe/Berlin
ZIMBRA_REMINDER_MINUTES=15
