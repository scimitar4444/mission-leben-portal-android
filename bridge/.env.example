BRIDGE_LISTEN_HOST=0.0.0.0
BRIDGE_LISTEN_PORT=8080
BRIDGE_DATABASE_PATH=/data/bridge.sqlite3
BRIDGE_AUTHENTIK_USERINFO_URL=https://id.mission-leben.de/application/o/userinfo/
BRIDGE_AUTHENTIK_DEVICE_STATUS_URL=https://geraete.mission-leben.de/api/v1/devices/status
BRIDGE_INTERNAL_HMAC_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
BRIDGE_DATA_KEY=replace-with-base64url-encoded-32-byte-key
# Duo Auth API compatible endpoint used only between Authentik and this bridge.
# Use the exact same three values in authentik/bootstrap_app_approval.py.
BRIDGE_DUO_INTEGRATION_KEY=replace-with-20-or-more-alphanumeric-characters
BRIDGE_DUO_SECRET_KEY=replace-with-at-least-32-random-characters
BRIDGE_DUO_API_HOSTNAME=id.mission-leben.de
BRIDGE_DUO_APPROVAL_TIMEOUT_SECONDS=60
BRIDGE_NTFY_PUBLIC_BASE_URL=https://push.mission-leben.de
BRIDGE_NTFY_INTERNAL_BASE_URL=http://ntfy:2586
BRIDGE_NTFY_AUTH_FILE=/ntfy/user.db
BRIDGE_NTFY_BINARY=/usr/local/bin/ntfy
BRIDGE_TALK_TARGETS_JSON=[]
BRIDGE_NEXTCLOUD_BACKEND_URL=https://cloud.example.invalid
BRIDGE_NEXTCLOUD_TALK_SECRET_FILE=/run/secrets/nextcloud-talk-bot-secret
# room token -> Authentik subjects that should receive this room's messages
BRIDGE_TALK_RECIPIENTS_JSON={}
# Nextcloud user id -> Authentik subject; used to suppress a notification to the sender
BRIDGE_NEXTCLOUD_USER_SUBJECTS_JSON={}
# Optional automatic Talk room membership. The narrow signed Nextcloud endpoint
# reuses the announcement integration secret; no Nextcloud user password is needed.
# BRIDGE_COMMUNICATION_DIRECTORY_FILE=/run/mission-leben-directory/communication-assignments.json
# Legacy fallback only:
# BRIDGE_NEXTCLOUD_TALK_API_USER=ml-push-bridge
# BRIDGE_NEXTCLOUD_TALK_API_PASSWORD_FILE=/run/mission-leben-directory/nextcloud-talk-api-password
# Read-only, signed Nextcloud adapter used for Announcement Center and the
# participant IDs of the one Talk room named in each request.
BRIDGE_NEXTCLOUD_ANNOUNCEMENTS_URL=https://cloud.example.invalid
BRIDGE_NEXTCLOUD_ANNOUNCEMENTS_SECRET_FILE=/run/secrets/nextcloud-announcements-secret
BRIDGE_ANNOUNCEMENT_CACHE_TTL_SECONDS=300
BRIDGE_ANNOUNCEMENT_STALE_TTL_SECONDS=86400

BRIDGE_BASE_URL=http://bridge:8080
ZIMBRA_ADMIN_SOAP_URL=https://mail.example.invalid:7071/service/admin/soap
ZIMBRA_MAIL_SOAP_URL=https://mail.example.invalid/service/soap
ZIMBRA_ADMIN_USER=portal-notify@example.invalid
ZIMBRA_ADMIN_PASSWORD_FILE=/run/secrets/zimbra-admin-password
ZIMBRA_ACCOUNT_MAP_FILE=/run/secrets/zimbra-account-map.json
ZIMBRA_DYNAMIC_ACCOUNT_MAP=true
ZIMBRA_TIMEZONE=Europe/Berlin
